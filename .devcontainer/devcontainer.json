{
    "name": "dbt-devcontainer",
    "remoteUser": "user",
    "updateRemoteUserUID": false,
    "dockerComposeFile": "docker-compose.yml",
    "service": "dbt-dev",
    "workspaceFolder": "/src",
    "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": true,
        "files.associations": {
                    "*.yaml": "jinja-yaml",
                    "*.yml": "jinja-yaml",
                    "*.sql": "jinja-sql",
                    "*.md": "jinja-md"
                },
    },
    "extensions": [
        "innoverio.vscode-dbt-power-user",
        "tripleaceme.dbt-flow-lineage"
    ]
    }
  },
    "shutdownAction": "stopCompose"
}