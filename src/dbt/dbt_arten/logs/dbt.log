  create  table "test-db"."dbt_arten"."bdry_wis_update__dbt_tmp"
  
  
    as
  
  (
    

SELECT
  -- gid generated automatically on insert (DEFAULT value)
  w.name_deutsch as art_wiss,
  w.name_lateinisch as art_deutsch,
  cat.spez_art as spezart,
  w.substrat,
