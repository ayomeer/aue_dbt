  NULL::boolean as loeschmarkierung,
  w.geometrie
FROM "test-db"."dbt_arten"."stg_imp_wisgl_besonderearten" as w
LEFT JOIN "test-db"."dbt_arten"."stg_cat_art" as cat
  ON cat.id_art = w.id_from_cat_arten
  );
