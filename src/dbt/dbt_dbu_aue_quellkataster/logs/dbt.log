  create view "test-db"."dbt_quellkataster"."staging_access_objektdaten_union__dbt_tmp"
    
    
  as (
    -- Creating union between these two data sources, because they share structure
WITH union_cte AS (
  SELECT 
    aname,
    lokalbezeichnung,
    ortschaft,
    postleitzahl,
    x_koordinate,
    y_koordinate,
    parz_nr,
    fassungseigentuemer,
    hoehe,
    schachtueberstand,
    ordnungs_nr,
    lagegenauigkeit,
    verwendungszweck,
    verwendungsart,
    fassungsart,
    fassungszustand,
    fassungsabdeckung,
    schachttyp,
    datenherkunft,
    kontaktperson,
    bemerkungen,
    foto,
    foto_negativ_nr_1,
    foto_negativ_nr_2,
    foto_negativ_nr_3,
    fassung,
    schutzzone,
    anzahl_zuleitungen,
    schloss,
    aufgenommen_durch,
    erhebungsdatum,
    alte_ordnungs_nr,
    feldbegehung,
    objektbereinigung,
    wva_nutzung,
    wva_nutzung_ergaenzen,
    wva_nutzung_streichen,
    wva_nutzung_lage_neu,
    geometrie
  FROM "test-db"."dbt_quellkataster"."staging_access_objektdaten"
  UNION
  SELECT 
    aname,
    lokalbezeichnung,
    ortschaft,
    postleitzahl,
    x_koordinate,
    y_koordinate,
    parz_nr,
    fassungseigentuemer,
    hoehe,
    schachtueberstand,
    ordnungs_nr,
    lagegenauigkeit,
    verwendungszweck,
    verwendungsart,
    fassungsart,
    fassungszustand,
    fassungsabdeckung,
    schachttyp,
    datenherkunft,
    kontaktperson,
    bemerkungen,
    foto,
    foto_negativ_nr_1,
    foto_negativ_nr_2,
    foto_negativ_nr_3,
    fassung,
    schutzzone,
    anzahl_zuleitungen,
    schloss,
    aufgenommen_durch,
    erhebungsdatum,
    alte_ordnungs_nr,
    feldbegehung,
    objektbereinigung,
    wva_nutzung,
    wva_nutzung_ergaenzen,
    wva_nutzung_streichen,
    wva_nutzung_lage_neu,
    geometrie
  FROM "test-db"."dbt_quellkataster"."staging_nachtraege"
)
SELECT
  row_number() OVER() as pkey_src,
